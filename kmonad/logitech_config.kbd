(defcfg
    input (device-file "/dev/input/by-id/usb-Logitech_USB_Receiver-if01-event-kbd")
    output (uinput-sink "Teclado KMonad")
    fallthrough true
    allow-cmd false
)

(defsrc
    caps
        
        lmet
)

(defalias esctl (tap-hold 200 esc ctl))
(defalias tapsuper (tap-hold 200 (around lmet d) lmet))

(deflayer default
    @esctl

        lmet
)
